f:["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"See how the two SQL tables connect"}],["$","p",null,{"className":"retail-detail-copy","children":"Reconstructed example using the supplied database schema. The attachment is a MySQL database dump rather than the original analysis-query script. Joining its two tables yields the same 3,900 records and source fields as the Excel “main” sheet."}],["$","pre",null,{"className":"retail-sql","children":["$","code",null,{"children":"SELECT\n  c.`Customer ID`, c.`Review Rating`,\n  c.`Discount Applied`, c.`Promo Code Used`,\n  p.`Item Purchased`, p.Category,\n  p.`Purchase Amount (USD)`, p.Season\nFROM table1 AS c\nINNER JOIN table2 AS p\n  ON c.`Customer ID` = p.`Customer ID`;"}]}],["$","p",null,{"className":"source-note","children":"Read-only example. The downloadable database dump contains CREATE, DROP and INSERT statements; open it for review or import it into a separate practice database."}]]}]
10:["$","section",null,{"className":"case-section case-two-col","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"03 / PRODUCT PREFERENCES"}],["$","h2",null,{"children":"Identify the winners and the exception."}],["$","p",null,{"children":"Jewelry, Pants, and Blouse lead the popularity index. Jeans ranks last, around 84 points below the next-lowest product, making it a focused candidate for a pricing, placement, or product review."}]]}],["$","$L19",null,{}]]}]
11:["$","section",null,{"className":"case-section case-two-col","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"04 / CATEGORY REVENUE"}],["$","h2",null,{"children":"A large category is not the same as a stronger product."}],["$","div",null,{"className":"retail-inline-finding","children":[["$","strong",null,{"children":"76.6%"}],["$","span",null,{"children":"of recorded revenue comes from Clothing and Accessories."}]]}],["$","p",null,{"children":"These categories contain 19 of the 25 product types. Revenue per product is much closer across categories, ranging from about $9,023 to $9,479. Category size helps explain why total revenue differs so much."}]]}],["$","$L1a",null,{}]]}]
12:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"05 / PROMOTIONS"}],["$","h2",null,{"children":"More promotion exposure does not establish higher spending."}],["$","div",null,{"className":"retail-promotion-layout","children":[["$","div",null,{"children":[["$","p",null,{"children":"43% of purchases include a promotion. Their average value is $59.28, compared with $60.13 without a promotion, an observed difference of −1.4%."}],["$","p",null,{"className":"retail-paragraph","children":"The pattern varies by category. Footwear shows a positive difference, making it a candidate for a controlled test rather than a reason to assume every promotion works."}],["$","div",null,{"className":"retail-overlap","children":[["$","h3",null,{"children":"Two fields. The same group."}],["$","p",null,{"children":"Every promo-code purchase also has a discount. The fields match in all 3,900 records, so we interpret them together as promotion exposure."}],["$","div",null,{"className":"data-table-wrap","children":["$","table",null,{"children":[["$","caption",null,{"className":"sr-only","children":"Overlap between promotion and discount indicators"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Promo code"}],["$","th",null,{"children":"Discount: Yes"}],["$","th",null,{"children":"Discount: No"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"children":"Yes"}],["$","td",null,{"children":"1,677"}],["$","td",null,{"children":"0"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"No"}],["$","td",null,{"children":"0"}],["$","td",null,{"children":"2,223"}]]}]]}]]}]}]]}]]}],["$","$L1b",null,{}]]}]]}]
13:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"06 / RECOMMENDATIONS"}],["$","h2",null,{"children":"What we would test next."}],["$","div",null,{"className":"method-steps retail-recommendations","children":[["$","article",null,{"children":[["$","span",null,{"className":"mono","children":"PRODUCTS"}],["$","h3",null,{"children":"Support demand, investigate Jeans"}],["$","p",null,{"children":"Keep the leading products visible and stocked. Review Jeans pricing, placement and feedback before deciding whether to change or replace the product."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"mono","children":"PROMOTIONS"}],["$","h3",null,{"children":"Start a controlled Footwear test"}],["$","p",null,{"children":"Compare a targeted offer with a control group. Measure conversion, purchase value and margin to evaluate incremental value rather than relying on group averages."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"mono","children":"DATA QUALITY"}],["$","h3",null,{"children":"Check how offers are assigned"}],["$","p",null,{"children":"Investigate why the promotion fields are identical and why exposure differs by customer group. Validate these rules before expanding a campaign."}]]}]]}]]}]
14:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"07 / THE PRESENTATION"}],["$","h2",null,{"children":"The group’s original analysis."}],["$","$L1c",null,{"titles":["Customer Shopping Behavior and Promotion Effectiveness","Our Chosen Topics and Dataset","Best-Selling Products and Consumer Preferences","Product Methodology and KPIs","Product Popularity","Product Popularity by Category","Category Popularity Index","Category Revenue","Impact of Ratings on Sales","Product Insights and Recommendations","Effectiveness of Discounts and Promotions","Promotion Methodology and KPIs","Promo Codes and Discounts Move Together","Promotion Exposure and Purchase Value","Promotion Exposure by Demographics","Promotion Exposure by Subscription Status","Seasonal Promotion Exposure","Promotion Exposure by Category","Category and Season","Promotion Insights and Recommendations"],"basePath":"/slides/retail-shopping","label":"Retail group project presentation"}]]}]
15:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"08 / METHODOLOGY & LIMITS"}],["$","h2",null,{"children":"Keep the conclusion tied to the evidence."}],["$","p",null,{"className":"case-takeaway","children":"This synthetic dataset is useful for practicing an analysis workflow. It describes recorded purchases and group differences, rather than real business impact or the causal effect of an offer."}],["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"Metric definitions and source checks"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Popularity index:"}]," purchase count × average review rating for each product type."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Revenue share:"}]," category purchase amount / $233,081 total purchase amount. No cost or margin information is supplied."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Promotion exposure:"}]," purchases with both promo-code and discount fields set to Yes / all purchases. The two fields are identical here."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Purchase-value difference:"}]," (average amount with exposure / average amount without exposure − 1) × 100. This is an association between observed groups."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Ratings comparison:"}]," Pearson correlation across 25 product types, using average rating and purchase count."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Source reconciliation:"}]," figures on this page were recomputed from the workbook’s source rows and reconciled with the two SQL tables. The original workbook and presentation are provided unchanged."]}]]}]]}],["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"How strongly do ratings relate to purchase count?"}],["$","p",null,{"className":"retail-detail-copy","children":["Across 25 product types, the Pearson correlation between average rating and purchase count is ",["$","strong",null,{"children":"r = −0.15"}],". This weak relationship suggests that ratings alone are a poor basis for inventory decisions in this dataset."]}]]}],["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"Where the supplied summaries differ from the source rows"}],["$","p",null,{"className":"retail-detail-copy","children":"The source rows give Outerwear the highest purchase count per product (162), while slide 7 names Footwear. The lowest revenue per product on slide 8 belongs to Footwear ($9,023), not Accessories. For subscription status, the source rows show exposure for all 1,053 subscribers and 624 of 2,847 non-subscribers; slide 16 reports different figures. The workbook’s Discount Impact summary also contains formula errors. The website uses recalculated source values for these comparisons."}]]}]]}]
