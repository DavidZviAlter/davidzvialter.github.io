13:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"06 / RECOMMENDATIONS"}],["$","h2",null,{"children":"The profiles I proposed."}],["$","div",null,{"className":"data-table-wrap","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Dimension"}],["$","th",null,{"children":"Conservative"}],["$","th",null,{"children":"Aggressive"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"children":"Genre"}],["$","td",null,{"children":"Comedy"}],["$","td",null,{"children":"Drama"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Actor"}],["$","td",null,{"children":"Steve Carell"}],["$","td",null,{"children":"Ryan Gosling"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Director"}],["$","td",null,{"children":"Seth Gordon"}],["$","td",null,{"children":"Alex Kendrick"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Budget"}],["$","td",null,{"children":"$$10M–$40M"}],["$","td",null,{"children":"$$10M–$40M"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Runtime"}],["$","td",null,{"children":"111–140 minutes"}],["$","td",null,{"children":"Under 90 minutes"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Content rating"}],["$","td",null,{"children":"PG"}],["$","td",null,{"children":"PG-13"}]]}],["$","tr",null,{"children":[["$","th",null,{"children":"Release window"}],["$","td",null,{"children":"March / October"}],["$","td",null,{"children":"May / August"}]]}]]}]]}]}],["$","p",null,{"className":"source-note","children":"Summarized from the detailed analysis in slides 8–12 and 15–19. Each dimension was analyzed separately. The final summary slide contains inconsistent labels; the profiles above follow the corresponding detailed slides."}]]}]
14:["$","section",null,{"className":"case-section","children":[["$","p",null,{"className":"eyebrow","children":"07 / METHODOLOGY & LIMITS"}],["$","h2",null,{"children":"What the numbers can tell us."}],["$","p",null,{"className":"case-takeaway","children":"The useful result is a framework for comparing trade-offs. Group averages are a starting point for investigation, rather than a prediction of a new movie’s performance."}],["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"Metric definitions and data scope"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"ROI proxy:"}]," (Gross revenue − Budget) / Budget × 100. This excludes unrecorded costs and revenue sharing, so it is not the investor’s net return."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Risk:"}]," the sample standard deviation of ROI, expressed in percentage points. It measures variability, not the probability of a loss."]}],["$","li",null,{"children":[["$","strong",null,{"children":"ROI over risk:"}]," mean ROI / standard deviation. This is a descriptive comparison ratio, not a Sharpe ratio."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Scope:"}]," the workbook contains 3,725 source rows. The displayed genre results reproduce its 2005–2015 analysis across available countries and languages. The presentation proposes a U.S./English focus, but those filters do not reproduce the saved genre averages."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sample sizes:"}]," the six compared genres have more than 100 records each in the workbook’s genre count. The highlighted actor and director comparisons use at least three records per person."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Budget boundaries:"}]," the workbook formula uses low < $10M, medium $10M to < $40M, high $40M to $100M inclusive, and blockbuster > $100M."]}]]}]]}],["$","details",null,{"className":"details-box","children":[["$","summary",null,{"children":"Limitations and what I would investigate next"}],["$","ul",null,{"children":[["$","li",null,{"children":"Very large returns from a few low-budget films can dominate averages. Medians, distributions, and outlier sensitivity would strengthen the comparison."}],["$","li",null,{"children":"The analysis does not establish that a specific actor, director, release month, or runtime causes higher returns."}],["$","li",null,{"children":"The source’s actor field and small samples limit what can be inferred about “star power.”"}],["$","li",null,{"children":"Audience and critic scores become available after release and should not be treated as information known at an investment decision."}],["$","li",null,{"children":"A next iteration would standardize filters across views, validate the revenue definition and source duplicates, and evaluate recommendations on a later time period."}]]}]]}]]}]
